---
import { reviews } from '../data/site'
import RatingStars from './RatingStars.astro'
---

<section class="section section-light reviews-section" aria-labelledby="reviews-title">
  <div class="section-inner">
    <div class="reviews-track-wrap" data-reveal>
      <h2 class="sr-only" id="reviews-title">Avaliações de alunos</h2>
      <div class="reviews-track" aria-label="Avaliações de alunos">
        {reviews.map((review) => (
          <article class="review-card">
            <RatingStars className="review-card-stars" rating={review.rating} />
            <blockquote>{review.text}</blockquote>
            <footer>
              <strong>{review.author}</strong>
            </footer>
          </article>
        ))}
      </div>
      <div class="reviews-pagination" aria-label="Selecionar avaliação">
        {reviews.map((review, index) => (
          <button
            class={`reviews-pagination-dot${index === 0 ? ' is-active' : ''}`}
            type="button"
            aria-label={`Ver avaliação de ${review.author}`}
            aria-current={index === 0 ? 'true' : undefined}
          />
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.reviews-track-wrap').forEach((wrap) => {
    const track = wrap.querySelector<HTMLDivElement>('.reviews-track')
    if (!track) return

    const cards = Array.from(track.querySelectorAll<HTMLElement>('.review-card'))
    const dots = Array.from(wrap.querySelectorAll<HTMLButtonElement>('.reviews-pagination-dot'))
    const setActiveReview = (activeIndex: number) => {
      dots.forEach((dot, index) => {
        dot.classList.toggle('is-active', index === activeIndex)
        if (index === activeIndex) dot.setAttribute('aria-current', 'true')
        else dot.removeAttribute('aria-current')
      })
    }

    track.addEventListener('scroll', () => {
      const closestReview = cards.reduce(
        (closest, card, index) => {
          const distance = Math.abs(card.offsetLeft - track.scrollLeft)
          return distance < closest.distance ? { distance, index } : closest
        },
        { distance: Number.POSITIVE_INFINITY, index: 0 },
      )
      setActiveReview(closestReview.index)
    }, { passive: true })

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        cards[index]?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' })
        setActiveReview(index)
      })
    })
  })
</script>
