---
import SiteHeader from './SiteHeader.astro'
import SiteFooter from './SiteFooter.astro'
import HeroSection from './sections/HeroSection.astro'
import AboutSection from './sections/AboutSection.astro'
import ProgramsSection from './sections/ProgramsSection.astro'
import GallerySection from './sections/GallerySection.astro'
import IntroSection from './sections/IntroSection.astro'
import ScheduleSection from './sections/ScheduleSection.astro'
import PricingSection from './sections/PricingSection.astro'
import StoreSection from './sections/StoreSection.astro'
import FaqSection from './sections/FaqSection.astro'
import ReviewsSection from './ReviewsSection.astro'
import WhereWeAreSection from './sections/WhereWeAreSection.astro'
---

<div class="site-shell" data-motion data-surfaces>
  <SiteHeader />
  <main>
    <HeroSection />
    <AboutSection />
    <ProgramsSection />
    <GallerySection />
    <IntroSection />
    <ScheduleSection />
    <PricingSection />
    <StoreSection />
    <FaqSection />
    <ReviewsSection />
    <WhereWeAreSection />
  </main>
  <SiteFooter />
</div>
