---
import TrackedLink from '../TrackedLink.astro'
import WhatsappLink from '../WhatsappLink.astro'
import WhatsAppIcon from '../icons/WhatsAppIcon.astro'
import InstagramIcon from '../icons/InstagramIcon.astro'
import YouTubeIcon from '../icons/YouTubeIcon.astro'
import LocationIcon from '../icons/LocationIcon.astro'
import { instagramUrl, youtubeUrl, fullAddress, mapsRouteUrl, whatsappUrls } from '../../data/site'
---

<section id="contato" class="section section-white contact-section">
  <div class="section-inner contact-layout">
    <div class="contact-copy" data-reveal>
      <h2 class="section-kicker">Entre em contato</h2>
      <div class="text-stack text-stack-large">
        <p>
          Quer conhecer melhor a Toca ou tirar uma dúvida? Chame a nossa recepção no
          WhatsApp ou venha nos visitar. Estamos em Cuiabá e será um prazer receber você.
        </p>
        <address>{fullAddress}</address>
      </div>

      <div class="contact-actions">
        <WhatsappLink
          className="button button-primary button-whatsapp"
          href={whatsappUrls.contact}
          source="contato_whatsapp"
       >
          <WhatsAppIcon />
          Chamar recepção no WhatsApp
        </WhatsappLink>
        <TrackedLink
          className="button button-outline-dark"
          href={mapsRouteUrl}
          event="route_click"
          newTab

          source="contato_como_chegar"
       >
          <LocationIcon />
          Traçar rota
        </TrackedLink>
      </div>

      <div class="contact-socials">
        <strong>Acompanhe nas redes sociais</strong>
        <div class="contact-social-links">
          <TrackedLink
            className="header-social-link contact-social-link"
            href={instagramUrl}
            event="instagram_click"
            newTab
            source="instagram_contato"
         >
            <InstagramIcon />
            <span class="sr-only">Siga a Toca no Instagram</span>
          </TrackedLink>
          <TrackedLink
            className="header-social-link contact-social-link"
            href={youtubeUrl}
            event="youtube_click"
            newTab
            source="youtube_contato"
         >
            <YouTubeIcon />
            <span class="sr-only">Inscreva-se no canal da Toca no YouTube</span>
          </TrackedLink>
        </div>
      </div>
    </div>

    <div class="map-frame" data-reveal>
      <iframe
        title="Localização da Toca do Leão"
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3842.6137355169635!2d-56.08886632409218!3d-15.612273118498576!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x939db0fa41085269%3A0x6d68be8f6a0134b6!2sToca do Leão Lifestyle Jiu-Jitsu!5e0!3m2!1spt-BR!2sbr!4v1780058142413!5m2!1spt-BR!2sbr"
        width="600"
        height="450"
        style={{ border: 0 }}
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
     />
    </div>
  </div>
</section>
