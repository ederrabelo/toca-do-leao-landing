---
import HomeHead from '../components/HomeHead.astro'
import HistoryHead from '../components/HistoryHead.astro'
import FloatingWhatsapp from "../components/FloatingWhatsapp.astro"
import '@fontsource-variable/manrope/wght.css'
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url'
import '../styles/global.css'
import '../styles/site.css'
import '../styles/surfaces.css'
import '../styles/motion.css'
import type { SectionRoute } from '../data/sectionRoutes'

interface Props { page?: 'home' | 'history'; section?: SectionRoute }
const { page = 'home', section } = Astro.props
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <link rel="preload" href={manropeLatin} as="font" type="font/woff2" crossorigin="anonymous" />
    {page === 'history' ? <HistoryHead /> : <HomeHead section={section} />}
  </head>
  <body data-section-target={section?.target}>
    <div id="root"><slot /></div>
    <FloatingWhatsapp />
    <script>
      import '../scripts/site'
      import '../scripts/motion'
    </script>
  </body>
</html>
